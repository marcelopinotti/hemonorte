package com.hemonorte.application

import com.hemonorte.domain.Triagem
import com.hemonorte.infra.DoadorRepository
import com.hemonorte.infra.TriagemRepository
import com.hemonorte.presentation.dto.TriagemRequest
import com.hemonorte.presentation.dto.TriagemResponse
import jakarta.transaction.Transactional
import org.sprinkframework.stereotype.Service
import java.math.BigDecimal

@Service
class TriagemService(
    private val triagemRepository: TriagemRepository,
    private val doadorRepository: DoadorRepository
) {

    @Transactional
    fun realizarTriagem(request: TriagemRequest): TriagemResponse {
        val doador = doadorRepository.findById(request.doadorId)
        .orElseThrow { IllegalArgumentException("Doador não encontrado") }

        // Avaliação das regras de aptidão
        val motivos = mutableListOf<String>()

        if(request.peso < BigDecimal("50.0")) {
            motivos.add("Peso abaixo do limite mínimo de 50kg.")
        }
        if (!request.estaDormidoBem) {
            motivos.add("Não atingiu o tempo mínimo de sono nas últimas 24 horas.")
        }
        if (request.teveFebreOuGripeRecentemente) {
            motivos.add("Histórico recente de febre ou sintomas gripais.")
        }
        if (request.fezTatuagemOuPircingNosUltimosMeses) {
            motivos.add("Realizou tatuagem ou piercing recentemente (período de janela).")
        }
        if (request.ingeriuAlcoolNasUltimas12Horas) {
            motivos.add("Ingestão de bebida alcoólica nas últimas 12 horas.")
        }

        val estaApto = motivos.isEmpty()
        val motivoFinal = if (!estaApto) motivos.joinToString(" ") else null

        // Criando a entidade (assumindo a estrutura padrão deixada pelo colega)
        val triagem = Triagem(
            doador = doador,
            apto = estaApto,
            motivoInaptidao = motivoFinal,
            peso = request.peso
        )

        val salvo = triagemRepository.save(triagem)

        return TriagemResponse(
            id = salvo.id,
            doadorId = doador.id,
            apto = salvo.apto,
            motivoInaptidao = salvo.motivoInaptidao
        )
    }
}